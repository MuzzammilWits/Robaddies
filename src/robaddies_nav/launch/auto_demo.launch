<launch>
  <node pkg="map_server"
        type="map_server"
        name="map_server"
        args="$(find robaddies_nav)/../../maps/surveillance_map.yaml"
        output="screen" />

  <node pkg="robaddies_nav"
        type="demo_route.py"
        name="demo_route"
        output="screen" />
</launch>
